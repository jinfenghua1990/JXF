# ===== 数据库 =====
# 留空/不配则用容器内 SQLite（./claims.db）；配了则连 Postgres
POSTGRES_PASSWORD=change-me

# ===== 旺店通开放平台 =====
WDT_SID=
WDT_APPKEY=
WDT_APPSECRET=
WDT_BASE_URL=https://api.wangdian.cn/openapi2

# 淘宝/天猫订单需走奇门自定义通道（未开通则留空）
# WDT_QIMEN_APPKEY=
# WDT_QIMEN_APPSECRET=
# WDT_QIMEN_TARGET_APPKEY=

# ===== 登录鉴权（外网暴露前必改）=====
# token 签名密钥，务必改成长随机串
APP_SECRET=
# 初始管理员；首次启动自动建号
ADMIN_EMAIL=admin@claims.local
ADMIN_PASSWORD=
# 开发期免登录开关，生产必须 false
DISABLE_AUTH=false

# ===== 机器凭证 =====
# 格式：渠道=密钥，多个逗号分隔，例：qqbot=xxxxxxxx
BOT_API_KEYS=
# 企业微信 bot 建单共享令牌
WECOM_BOT_TOKEN=

# ===== 备份 =====
BACKUP_INTERVAL_HOURS=24
KEEP_DAYS=30

# ===== 构建（内网可换镜像源）=====
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=60
PIP_RETRIES=5
